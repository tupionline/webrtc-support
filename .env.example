# TURN server credentials (from metered.ca or any TURN provider)
# Leave blank to run STUN-only (local network only)
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: override the TURN hostname (default: openrelay.metered.ca)
# TURN_HOST=yourapp.relay.metered.ca

# Anthropic API key — enables AI frame analysis button on the agent console
ANTHROPIC_API_KEY=
